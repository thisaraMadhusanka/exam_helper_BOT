# Copy to backend/.env for local development. Never commit the real .env file.

# Groq primary LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter fallback LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Supabase server-side credentials (SUPABASE_KEY must be the secret key)
SUPABASE_URL=
SUPABASE_KEY=

# Signed anonymous workspaces — generate a long random secret for deployment
SESSION_SECRET=
SESSION_TTL_HOURS=168

# Admin credentials - set in backend/.env and never in frontend variables
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# PDF and retrieval settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
# Calibrate against real answerable/unanswerable PDF questions before setting.
MIN_SIMILARITY=
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Optional; public embedding models normally do not require a token.
HF_TOKEN=
