# PDF RAG Assistant - Backend Environment Variables
# Template for backend/.env. Keep real credentials out of this file.
# NEVER commit the real .env file to version control

# Session / workspace token settings
# Generate a secure random secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
SESSION_TTL_HOURS=168

# PDF processing settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200

# CORS settings (comma-separated)
# Server port
PORT=8001

# Admin credentials — set all values in the ignored backend/.env file.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_ACCESS_CODE=ADMIN-TM-NEW

# CORS settings (comma-separated). Add the exact production Vercel origin in
# Hugging Face Space secrets; do not use "*" for a credentialed frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Embedding settings (Phase 2+)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval settings (Phase 2+)
TOP_K=4
MIN_SIMILARITY=

# LLM settings (Phase 3)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Supabase settings (Phase 2+); use the server-only secret key for SUPABASE_KEY.
SUPABASE_URL=
SUPABASE_KEY=

# Optional Hugging Face token for model downloads
HF_TOKEN=